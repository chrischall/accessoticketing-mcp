# Optional. An accesso ticket link from an order-confirmation email, used when a
# tool is called without an explicit `url`.
#
# This URL *is* the credential — its oToken grants the order's tickets to anyone
# who holds it. Keep this file out of git (.env is gitignored).
ACCESSO_TICKET_URL=

# Optional. Where accesso_save_barcodes writes PNGs. Defaults to the working directory.
ACCESSO_OUTPUT_DIR=

# Optional. Set to 1 when this server runs somewhere the user cannot reach the
# filesystem (a remote/hosted deployment), so barcodes come back inline instead
# of as paths the caller cannot open.
ACCESSO_NO_FILE_OUTPUT=
